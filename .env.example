# Facet build-time configuration.
#
# Facet is a static SPA with no runtime server, so these values are inlined at
# build time. Copy to `.env` (or export in the build environment) and rebuild.
# All variables are declared and validated in `src/env.ts`.

# Enable OpenTelemetry browser tracing (OTLP/HTTP). Default: false.
PUBLIC_OTEL_ENABLED=false

# OTLP/HTTP traces endpoint. Default: /v1/traces (same-origin collector proxy).
PUBLIC_OTEL_EXPORTER_OTLP_ENDPOINT=/v1/traces

# service.name resource attribute reported on exported spans. Default: facet-webui.
PUBLIC_OTEL_SERVICE_NAME=facet-webui

# NATS WebSocket URL for backend communication, e.g. wss://bmc.local:443.
PUBLIC_NATS_WS_URL=

# Back the transport with the in-process mock instead of a real NATS server.
# Set true for live UI development without hardware: `PUBLIC_USE_MOCK=true pnpm dev`
# (or `pnpm tauri dev`). Default: false.
PUBLIC_USE_MOCK=false

# Which mock scenario to serve when PUBLIC_USE_MOCK=true. Built-in: rack-mixed,
# single-bmc. Switch scenarios to test different topologies live. Default: rack-mixed.
PUBLIC_MOCK_SCENARIO=rack-mixed
