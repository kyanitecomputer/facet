{
	"name": "facet",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"license": "Apache-2.0 OR MIT",
	"author": "Kyanite",
	"packageManager": "pnpm@11.3.0",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --strategy cookie preferredLanguage baseLocale && svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "biome format --write .",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"test:unit": "vitest",
		"test:e2e": "playwright install && playwright test",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"tauri": "tauri"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.0",
		"@bufbuild/protobuf": "2.12.0",
		"@bufbuild/protovalidate": "1.2.0",
		"@connectrpc/connect": "2.1.1",
		"@connectrpc/connect-web": "2.1.1",
		"@inlang/paraglide-js": "2.20.0",
		"@kyanite/schema": "file:../schema/gen/ts",
		"@lucide/svelte": "1.21.0",
		"@nats-io/jetstream": "3.4.0",
		"@nats-io/nats-core": "3.4.0",
		"@novnc/novnc": "1.7.0",
		"@opentelemetry/api": "1.9.1",
		"@opentelemetry/context-zone": "2.8.0",
		"@opentelemetry/exporter-trace-otlp-http": "0.219.0",
		"@opentelemetry/instrumentation": "0.219.0",
		"@opentelemetry/instrumentation-document-load": "0.64.0",
		"@opentelemetry/instrumentation-fetch": "0.219.0",
		"@opentelemetry/resources": "2.8.0",
		"@opentelemetry/sdk-trace-web": "2.8.0",
		"@opentelemetry/semantic-conventions": "1.41.1",
		"@playwright/test": "1.61.0",
		"@sveltejs/adapter-static": "3.0.10",
		"@sveltejs/kit": "2.66.0",
		"@sveltejs/vite-plugin-svelte": "7.1.2",
		"@tailwindcss/vite": "4.3.1",
		"@tauri-apps/api": "2.11.1",
		"@tauri-apps/cli": "2.11.3",
		"@types/node": "26.0.0",
		"@vitest/browser-playwright": "4.1.9",
		"@xterm/addon-fit": "0.11.0",
		"@xterm/xterm": "6.0.0",
		"animejs": "4.4.1",
		"playwright": "1.61.0",
		"svelte": "5.56.3",
		"svelte-check": "4.6.0",
		"tailwindcss": "4.3.1",
		"typescript": "6.0.3",
		"uplot": "1.6.32",
		"vite": "8.0.16",
		"vitest": "4.1.9",
		"vitest-browser-svelte": "2.1.1"
	},
	"dependenciesMeta": {
		"@kyanite/schema": {
			"injected": true
		}
	}
}
